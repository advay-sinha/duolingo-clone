# Backend configuration.
#
# Copy to `backend/.env` for local overrides. **Nothing here is required for
# local development** -- every value below is already the default in
# app/core/config.py, and the commented lines document the key rather than set it.
#
# No secret belongs in this file. It is committed.

# ===========================================================================
# ENVIRONMENT
# ===========================================================================
# development | test | production
#
# Defaults to `development`, so working locally needs no configuration. Setting
# it to `production` turns on the startup checks at the bottom of config.py,
# which REFUSE TO BOOT on an unsafe configuration rather than running quietly
# insecurely. See the production section below for what they require.
# ENVIRONMENT=development


# ===========================================================================
# DATABASE
# ===========================================================================
# The default is an absolute path to backend/duolingo.db, computed in
# app/core/config.py so the file is found no matter which directory the process
# was started from.
#
# Left commented ON PURPOSE: copying this file to .env must not override the
# absolute default with a relative path, which would resolve against the current
# working directory and silently open a different (empty) database.
#
# PRODUCTION (Phase 10.3): a hosted libSQL/Turso database, because the deployed
# environment has no durable writable filesystem for a SQLite file. The URL
# carries the auth token as a query parameter:
#
#   DATABASE_URL=sqlite+libsql://<your-db>-<your-org>.turso.io/?secure=true
#   TURSO_AUTH_TOKEN=<token>
#
# ** NOTE THE `sqlite+` PREFIX. This is the single easiest thing to get wrong. **
# `turso db show <db> --url` prints the URL in Turso's OWN scheme:
#
#     libsql://my-db-org.turso.io          <-- what the CLI gives you
#     sqlite+libsql://my-db-org.turso.io   <-- what SQLAlchemy needs
#
# SQLAlchemy has no "libsql" backend; libSQL is a *dialect of sqlite*, so the URL
# must name the backend and the driver. Pasting the CLI's output directly makes
# the application fail at import with:
#
#     NoSuchModuleError: Can't load plugin: sqlalchemy.dialects:libsql
#
# The application now refuses to start with a message naming the correction, but
# the prefix is still yours to add.
#
# ** THE TOKEN IS A SEPARATE VARIABLE: TURSO_AUTH_TOKEN. **
# Turso's own documentation writes the URL as `libsql://host?authToken=...`, and
# that DOES NOT WORK here. The driver takes the token as a keyword argument to
# connect() -- its entry point is `open_remote_internal(database, auth_token,
# version)` with auth_token defaulting to "" -- and never parses it out of the
# query string. The SQLAlchemy dialect does not forward it either. A token in
# the URL is therefore silently dropped and Turso rejects the first query with
#
#     database: empty JWT token
#
# So set two variables:
#
#     DATABASE_URL=sqlite+libsql://<your-db>-<your-org>.turso.io/?secure=true
#     TURSO_AUTH_TOKEN=<token>
#
# `secure=true` stays in the URL: it is consumed by the dialect and selects https
# rather than http, which a hosted database requires.
#
# ** USE THE DATABASE TOKEN, NOT YOUR ACCOUNT TOKEN. ** Turso has two, and they
# are easy to confuse:
#
#     turso auth token              -> your ACCOUNT/API token; authenticates the
#                                      CLI to Turso. NOT this. Never put it here.
#     turso db tokens create <db>   -> the DATABASE token; grants access to one
#                                      database. This is the one.
#
# TURSO_AUTH_TOKEN is a secret: set it in the hosting platform's environment
# variables and nowhere else. There is no placeholder below, because a
# half-filled credential is worse than an absent one.
# TURSO_AUTH_TOKEN=
#
# **The token is a secret.** Set it in the hosting platform's environment
# variables, never here and never in git. There is no placeholder value below
# because a half-filled credential is worse than an absent one.
#
# Note the dialect: `sqlite+libsql`. SQLAlchemy still generates SQLite SQL and
# every model, repository and service is unchanged -- only the driver differs.
#
# If instead you deploy to a host with a persistent volume, a plain file is
# still correct:
#   DATABASE_URL=sqlite:////data/duolingo.db     (note the four slashes)
#
# Production REFUSES TO START if this points inside the application directory,
# because that is the default and it is never durable in a deployment.
#
# ** DO NOT SET THE PRODUCTION URL IN THIS FILE (backend/.env). **
# It belongs in the hosting platform's environment variables. Put a Turso URL
# here and local development breaks: the libSQL driver has no Windows wheel, so
# `app/db/session.py` cannot build its engine at import and every command --
# including `pytest` -- fails before it starts. This key stays commented for
# exactly that reason.
# DATABASE_URL=

# Print every SQL statement the ORM emits. Useful while learning; noisy
# otherwise. **Refused in production** -- it writes parameters, including email
# addresses, into the platform's logs.
# DATABASE_ECHO=false


# ===========================================================================
# CORS
# ===========================================================================
# Origins the browser may call this API from directly.
#
# FORMAT -- any of these three, whichever your deployment dashboard makes easiest:
#
#   comma-separated   CORS_ORIGINS=https://app.example.com,https://www.example.com
#   a single origin   CORS_ORIGINS=https://app.example.com
#   JSON              CORS_ORIGINS=["https://app.example.com"]
#   empty             CORS_ORIGINS=
#
# An empty value means NO cross-origin access. It never means "allow
# everything" -- reading a blank box as a wildcard would turn a typo into an open
# API.
#
# Each entry must be a bare ORIGIN: scheme + host + optional port. No path, no
# trailing slash. `https://app.example.com/api` and `https://app.example.com/`
# are both rejected with a message saying what to use instead, because the
# browser compares the Origin header as an exact string -- a trailing slash
# matches nothing and looks like a broken app rather than a mistyped setting.
#
# It can NEVER be "*": a wildcard origin and credentialed requests are
# incompatible by specification, and this API authenticates with a cookie.
#
# **In the recommended deployment this should be EMPTY.** The frontend proxies
# /api/v1/* under its own origin (see frontend/next.config.ts), so the browser
# never makes a cross-origin request and there is nothing for CORS to govern. An
# allowlist that is not needed is an allowlist that can only be wrong.
#
# Production example (same-origin topology):
#   CORS_ORIGINS=
# Production example (frontend on a separate origin):
#   CORS_ORIGINS=https://my-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ===========================================================================
# AUTHENTICATION
# ===========================================================================
# The cookie the session token travels in. MUST match SESSION_COOKIE_NAME in the
# frontend's environment -- `frontend/proxy.ts` looks for a cookie with this name.
# SESSION_COOKIE_NAME=duolingo_session

# How long a session stays valid.
# SESSION_LIFETIME_DAYS=14

# **REQUIRED IN PRODUCTION.** Without it the session cookie is sent over plain
# http and anyone on the network can read it. False here only because local
# development is http. Production refuses to start without it.
# SESSION_COOKIE_SECURE=false

# bcrypt cost factor: the work doubles with each increment. 12 is a sensible
# default for a login someone waits on. The test suite lowers this to 4, which is
# safe because the cost is recorded inside every hash string -- existing hashes
# keep the factor they were created with.
# BCRYPT_ROUNDS=12

# There is deliberately NO SESSION_SECRET. Session tokens are 32 random bytes
# stored as a SHA-256 digest and looked up, not signed and verified, so there is
# no key to manage, rotate or leak. Adding one because production systems usually
# have one would be cargo cult.


# ===========================================================================
# LOGIN RATE LIMITING (Phase 10)
# ===========================================================================
# Failed logins allowed per (email, client IP) per window before the endpoint
# answers 429. Counting is per FAILURE; a successful login clears the key, so a
# learner signing in normally is never limited.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300

# Whether to believe X-Forwarded-For when identifying the caller.
#
# **Off by default, and that default is a security decision.** The header is
# attacker-controlled: trusted with no proxy in front, anyone can send a fresh
# value per request and the rate limit becomes decorative.
#
# Set it to true ONLY when this app sits behind a proxy that overwrites the
# header -- which every managed platform (Fly, Railway, Render, a load balancer)
# does. **In production behind such a platform you almost certainly want this
# on**, because otherwise every request appears to come from the proxy and all
# learners share one rate-limit bucket.
# TRUST_PROXY_HEADERS=false


# ===========================================================================
# SEEDED DEMO LEARNER
# ===========================================================================
# The account `python -m app.db.seed` creates. Since Phase 9 it is a normal
# account that signs in through POST /auth/login like any other.
#
# The default password is NOT a secret in any meaningful sense locally: it
# protects a SQLite file containing practice Spanish. **Production refuses to
# start while it is still the committed default** -- set your own, or do not seed
# the demo learner at all.
# DEMO_EMAIL=learner@example.com
# DEMO_USER_PASSWORD=duolingo123


# ===========================================================================
# A MINIMAL PRODUCTION .env
# ===========================================================================
# ENVIRONMENT=production
# DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io/?secure=true
# TURSO_AUTH_TOKEN=<token>
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY_HEADERS=true
# CORS_ORIGINS=
# DEMO_USER_PASSWORD=<something only you know>
