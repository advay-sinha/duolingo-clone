# Copy to backend/.env to override defaults locally. No secrets belong in this file.
# Values here are the defaults already baked into app/core/config.py.

# Origins the browser is allowed to call this API from (JSON array).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Where the database lives. The default is an absolute path to
# backend/duolingo.db, computed in app/core/config.py so the file is found no
# matter which directory the process was started from.
# Left commented on purpose: copying this file to .env must not override the
# absolute default with a relative path, which would resolve against the current
# working directory and silently open a different (empty) database.
# Uncomment only to point somewhere specific, and use an absolute path:
#   DATABASE_URL=sqlite:///D:/tmp/scratch.db
# Moving to Postgres later is this line plus Alembic -- no code changes.
# DATABASE_URL=

# Print every SQL statement the ORM emits. Useful while learning; noisy otherwise.
# DATABASE_ECHO=false
