# Copy to backend/.env to override defaults locally. No secrets belong in this file.
# Values here are the defaults already baked into app/core/config.py.

# Origins the browser is allowed to call this API from (JSON array).
# Since Phase 9 these requests carry credentials (the session cookie), which is
# why this is an explicit list and can never be "*" -- a wildcard origin and
# allow_credentials are incompatible, and for good reason.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- authentication (Phase 9) ---------------------------------------------
# The cookie the session token travels in. Must match SESSION_COOKIE in
# frontend/proxy.ts.
# SESSION_COOKIE_NAME=duolingo_session

# How long a session stays valid.
# SESSION_LIFETIME_DAYS=14

# MUST be true for any https deployment, or the session cookie is sent in the
# clear and anyone on the network can read it. False here only because local
# development is plain http.
# SESSION_COOKIE_SECURE=false

# bcrypt cost factor: the work doubles with each increment. 12 is a sensible
# default for a login someone waits on. The test suite lowers this to 4, which
# is safe because the cost is recorded inside every hash string -- existing
# hashes keep the factor they were created with.
# BCRYPT_ROUNDS=12

# --- seeded demo learner ---------------------------------------------------
# The account `python -m app.db.seed` creates. Since Phase 9 it is a normal
# account that signs in through POST /auth/login like any other.
#
# This is NOT a secret in any meaningful sense: it protects a local SQLite file
# containing practice Spanish, and the default exists so a fresh clone can be
# logged into without ceremony. Set your own here if this instance is reachable
# by anyone else -- or delete the account.
# DEMO_EMAIL=learner@example.com
# DEMO_USER_PASSWORD=duolingo123

# Where the database lives. The default is an absolute path to
# backend/duolingo.db, computed in app/core/config.py so the file is found no
# matter which directory the process was started from.
# Left commented on purpose: copying this file to .env must not override the
# absolute default with a relative path, which would resolve against the current
# working directory and silently open a different (empty) database.
# Uncomment only to point somewhere specific, and use an absolute path:
#   DATABASE_URL=sqlite:///D:/tmp/scratch.db
# Moving to Postgres later is this line plus Alembic -- no code changes.
# DATABASE_URL=

# Print every SQL statement the ORM emits. Useful while learning; noisy otherwise.
# DATABASE_ECHO=false
